{{- $work := false }}
{{- if hasKey . "work_machine" }}{{ $work = .work_machine }}{{ end }}
{{- if $work -}}
#!/bin/bash
# antigravity-acp: skipped on work (Lendable) machines — personal only.
set -eufo pipefail

# Remove the bridge if the machine was reclassified as work.
rm -f "$HOME/.local/bin/agy-acp"
echo "antigravity-acp skipped on work machine."
{{- else -}}
#!/bin/bash
# antigravity-acp (https://github.com/shubzkothekar/antigravity-acp): v1.2.0
# ACP bridge for Antigravity: `agy` has no native `--acp` flag, so this
# provides the `agy-acp` binary behind the `antigravity` CodeCompanion chat
# adapter. Personal (non-Lendable) machines only — see $work gating above.
# Prebuilt release binary -> ~/.local/bin/agy-acp.
# Bump the version below (both the comment and `version=`) to upgrade;
# chezmoi re-runs this script when its rendered contents change.
set -eufo pipefail

version="v1.2.0"

bin="$HOME/.local/bin/agy-acp"

if [ -x "$bin" ] && "$bin" --version 2>/dev/null | grep -q "${version#v}"; then
  echo "antigravity-acp ${version} already installed."
  exit 0
fi

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$arch" in
  x86_64) arch="x64" ;;
  aarch64 | arm64) arch="arm64" ;;
  *)
    echo "Unsupported arch: $arch" >&2
    exit 1
    ;;
esac
case "$os" in
  darwin | linux) ;;
  *)
    echo "Unsupported OS: $os" >&2
    exit 1
    ;;
esac

asset="agy-acp-${os}-${arch}"
url="https://github.com/shubzkothekar/antigravity-acp/releases/download/${version}/${asset}"

echo "Installing antigravity-acp ${version} (${asset})..."
mkdir -p "$(dirname "$bin")"
curl -fsSL -o "$bin" "$url"
chmod +x "$bin"
echo "antigravity-acp installed to $bin"
{{- end }}
