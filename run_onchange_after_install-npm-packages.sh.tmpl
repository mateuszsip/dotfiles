#!/bin/bash
# npm: {{ include "packages_npm.txt" | sha256sum }}
# Global npm packages from packages_npm.txt, one `name@version` per line.
# Bump a version there to upgrade; chezmoi re-runs on change. Globals not in
# the list are uninstalled (npm and corepack excepted).
set -eufo pipefail

if ! command -v npm &>/dev/null; then
  echo "npm not installed, skipping global npm packages."
  exit 0
fi

root=$(npm root -g)
if [ ! -w "$root" ] && [ ! -w "$(dirname "$root")" ]; then
  echo "npm global root $root not writable, skipping global npm packages."
  exit 0
fi

npm install -g \
{{ include "packages_npm.txt" | trim | splitList "\n" | join " \\\n  " }}

expected=$(sed -E 's/^(@?[^@]+)@.*/\1/' <<'EOF_LIST' | sort
{{ include "packages_npm.txt" | trim }}
EOF_LIST
)
installed=$(npm ls -g --depth=0 --json \
  | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>console.log(Object.keys(JSON.parse(s).dependencies||{}).join("\n")))' \
  | grep -v -x -E 'npm|corepack' | sort)

extras=$(comm -23 <(echo "$installed") <(echo "$expected") | sed '/^$/d')
if [ -n "$extras" ]; then
  echo "Uninstalling global npm packages not in packages_npm.txt:"
  echo "$extras" | sed 's/^/  /'
  # shellcheck disable=SC2086
  npm uninstall -g $extras
fi
