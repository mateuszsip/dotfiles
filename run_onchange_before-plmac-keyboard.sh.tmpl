{{- if (eq .chezmoi.os "linux") -}}
#!/bin/bash
# Install a custom XKB symbols file "plmac" that combines the Macintosh UK
# layout (gb/mac, with `~ next to Z on Mac ISO keyboards) with Polish
# diacritics on AltGr (level 3):
#   AltGr + a=ą  c=ć  e=ę  l=ł  n=ń  o=ó  s=ś  x=ź  z=ż
#
# Survives xkeyboard-config package updates: pacman only tracks files it owns,
# and "plmac" is a brand-new filename not shipped by xkeyboard-config.
# xkb's evdev rules have a fallback "* * = pc+%l%(v)" that resolves any layout
# name to symbols/<layout>, so no rules/.lst/.xml registration is needed.

set -euo pipefail

DEST=/usr/share/X11/xkb/symbols/plmac

CONTENT='// Custom Polish-English (Macintosh ISO) keyboard layout.
// Base: English (UK, Macintosh) — preserves `~ next to Z on Mac ISO keyboards.
// Adds Polish diacritics accessible via AltGr (level 3):
//   AltGr+a=ą  c=ć  e=ę  l=ł  n=ń  o=ó  s=ś  x=ź  z=ż
// Installed by chezmoi run_onchange_before-plmac-keyboard.sh.tmpl

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "gb(mac)"

    name[Group1] = "Polish (Macintosh, custom)";

    key <AC01> { [ a, A, aogonek,   Aogonek   ] };
    key <AC02> { [ s, S, sacute,    Sacute    ] };
    key <AC09> { [ l, L, lstroke,   Lstroke   ] };
    key <AD03> { [ e, E, eogonek,   Eogonek   ] };
    key <AD09> { [ o, O, oacute,    Oacute    ] };
    key <AB01> { [ z, Z, zabovedot, Zabovedot ] };
    key <AB02> { [ x, X, zacute,    Zacute    ] };
    key <AB03> { [ c, C, cacute,    Cacute    ] };
    key <AB06> { [ n, N, nacute,    Nacute    ] };
};
'

# Deploy (idempotent: only writes when content differs)
if [ ! -f "$DEST" ] || ! diff -q <(printf '%s' "$CONTENT") "$DEST" >/dev/null 2>&1; then
    echo "Installing plmac XKB symbols to $DEST"
    printf '%s' "$CONTENT" | sudo tee "$DEST" >/dev/null
fi
{{ end -}}