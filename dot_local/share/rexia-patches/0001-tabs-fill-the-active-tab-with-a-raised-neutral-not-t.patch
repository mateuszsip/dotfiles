From f5e8c34a35fed3764535b4844a6534ef5dcce511 Mon Sep 17 00:00:00 2001
From: Mateusz Sip <mateusz.sip@gmail.com>
Date: Wed, 18 Nov 2026 01:05:24 +0100
Subject: [PATCH 1/3] tabs: fill the active tab with a raised neutral, not the
 accent

---
 src/ui/workspace/mod.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/ui/workspace/mod.rs b/src/ui/workspace/mod.rs
index e85e335..04a1be0 100644
--- a/src/ui/workspace/mod.rs
+++ b/src/ui/workspace/mod.rs
@@ -1152,8 +1152,11 @@ impl Workspace {
                 let muted = self.tab_muted(self.active, window.id());
                 // Filling tabs show a background only when there's more than one.
                 let lone = fill && count < 2;
+                // The active tab uses a raised neutral surface rather than the accent:
+                // it reads like a Neovim buffer chip and leaves the accent for status
+                // and focus. Local fork: mateuszsip/rexia, branch local-tweaks.
                 let (fg, bg) = if active && !lone {
-                    (theme.on_primary, theme.primary)
+                    (theme.text, theme.surface_highest)
                 } else {
                     (theme.text, theme.background)
                 };
