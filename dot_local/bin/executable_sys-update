#!/bin/bash
# Update the system: official repos + AUR through paru.
#
# Interactive (paru asks for confirmation and sudo), so run it in a terminal —
# the waybar module opens one with `sys-launch float sys-update`.

set -uo pipefail

if command -v paru >/dev/null; then
  paru -Syu --sudoloop
  status=$?
else
  sudo pacman -Syu
  status=$?
fi

# Refresh the update counter in waybar right away (custom/update listens on
# SIGRTMIN+8 and re-runs sys-update-available) instead of leaving a stale count
# up to 6h until the module's interval elapses. Also fires on abort.
pkill -RTMIN+8 -x waybar 2>/dev/null

exit "$status"
