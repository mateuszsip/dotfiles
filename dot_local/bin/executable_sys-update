#!/bin/bash
# Update the system: official repos + AUR through paru.
#
# Interactive (paru asks for confirmation and sudo), so run it in a terminal —
# the waybar module opens one with `sys-launch float sys-update`.
#
# The update counter in waybar is refreshed by /etc/pacman.d/hooks/
# 90-waybar-updates.hook (installed by run_onchange_before_setup-system), which
# fires on every transaction regardless of who started it.

set -uo pipefail

if command -v paru >/dev/null; then
  exec paru -Syu --sudoloop
fi

exec sudo pacman -Syu
