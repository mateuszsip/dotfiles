#!/bin/bash
# Set the power profile for an AC/battery change.
#
#   sys-power-profile [autodetect|ac|battery]
#
# Without an argument (or with "autodetect") it looks at the power supplies:
# any Mains/USB device reporting online=1 counts as AC. This handles USB-C-only
# laptops where the legacy AC device never fires a udev event.
#
# Called from /etc/udev/rules.d/99-power-profile.rules on power-supply changes.

powerprofilesctl list >/dev/null 2>&1 || exit 0

action="${1:-autodetect}"

if [[ $action == autodetect ]]; then
  action=battery
  for ps in /sys/class/power_supply/*; do
    [[ -r $ps/online && -r $ps/type ]] || continue
    type=$(<"$ps/type")
    [[ $type == Mains || $type == USB ]] || continue
    if [[ $(<"$ps/online") == 1 ]]; then
      action=ac
      break
    fi
  done
fi

profiles=$(powerprofilesctl list | awk '/^[[:space:]]*[* ]?[a-zA-Z0-9-]+:$/ { gsub(/^[*[:space:]]+|:$/, ""); print }')

case $action in
ac)
  # Prefer performance, fall back to balanced when the platform has no such profile
  if [[ " $profiles " == *" performance "* ]]; then
    powerprofilesctl set performance
  else
    powerprofilesctl set balanced
  fi
  ;;
battery)
  powerprofilesctl set balanced
  ;;
*)
  echo "usage: sys-power-profile [autodetect|ac|battery]" >&2
  exit 2
  ;;
esac
