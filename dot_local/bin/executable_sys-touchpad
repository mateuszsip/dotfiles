#!/bin/bash
# Enable, disable, or toggle the touchpad.
#
#   sys-touchpad [on|off|toggle]
#
# The disabled state is persisted in the Hyprland toggles directory so it
# survives a reload and a restart.

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr/toggles/touchpad-disabled.conf"

device=$(hyprctl devices -j | jq -r '[.mice[] | .name | select(test("touchpad|trackpad"; "i"))] | first // empty')

if [[ -z $device ]]; then
  echo "No touchpad device found" >&2
  exit 1
fi

enable() {
  hyprctl keyword "device[$device]:enabled" true >/dev/null
  rm -f "$STATE"
  sys-osd --custom-icon input-touchpad-symbolic --custom-message "Touchpad enabled"
}

disable() {
  hyprctl keyword "device[$device]:enabled" false >/dev/null
  mkdir -p "$(dirname "$STATE")"
  printf 'device {\n    name = %s\n    enabled = false\n}\n' "$device" >"$STATE"
  sys-osd --custom-icon touchpad-disabled-symbolic --custom-message "Touchpad disabled"
}

case "${1:-toggle}" in
on) enable ;;
off) disable ;;
toggle)
  if [[ -f $STATE ]]; then enable; else disable; fi
  ;;
*)
  echo "Usage: $(basename "$0") [on|off|toggle]" >&2
  exit 2
  ;;
esac
