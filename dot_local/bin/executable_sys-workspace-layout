#!/bin/bash
# Toggle the layout of the focused workspace between dwindle and scrolling.

workspace=$(hyprctl activeworkspace -j | jq -r '.id')
current=$(hyprctl activeworkspace -j | jq -r '.tiledLayout')

case $current in
dwindle) new=scrolling ;;
*) new=dwindle ;;
esac

hyprctl eval "hl.workspace_rule({ workspace = \"$workspace\", layout = \"$new\" })" >/dev/null
notify-send -u low "Workspace layout set to $new"
