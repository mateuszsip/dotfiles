#!/bin/bash
# Installs the tools pinned in dot_config/mise/config.toml (node plus any
# npm:-backed global CLIs).
# The mise package only ships the CLI; the tools themselves are downloaded per
# machine. `after` ordering keeps this behind the packages script, and lexical
# order keeps it ahead of install-node-packages (which needs npx).
# config: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -eufo pipefail

# mise is installed by the packages script; skip rather than fail the apply if
# that has not happened yet (e.g. a partial bootstrap).
command -v mise &>/dev/null || exit 0

mise install

# zen-mcp: write its per-machine config (~/.config/zen-mcp/config.json) —
# setup detects the Zen executable, which differs per OS. Machines without
# Zen installed keep the tool unused; don't fail the apply over it.
# ZEN_MCP_NO_SKILL_PROMPT guards the skills-CLI offer for interactive shells.
ZEN_MCP_NO_SKILL_PROMPT=1 mise x -- zen-mcp setup || \
    echo "zen-mcp setup: no usable Zen install here (non-fatal)" >&2
