[Unit]
Description=Matcha email sync daemon
After=graphical-session.target

[Service]
Type=simple
# The TUI auto-spawns its own daemon when it cannot reach one, so make sure
# systemd owns it. Stop any stray daemon and wait for its PID file to go away
# before starting, otherwise `daemon run` exits with "already running".
ExecStartPre=-/usr/bin/sh -c 'matcha daemon stop >/dev/null 2>&1; p="${XDG_RUNTIME_DIR}/matcha/daemon.pid"; for _ in $(seq 1 50); do [ -f "$p" ] || exit 0; kill -0 "$(cat "$p" 2>/dev/null)" 2>/dev/null || exit 0; sleep 0.1; done'
ExecStart=/usr/bin/matcha daemon run
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
