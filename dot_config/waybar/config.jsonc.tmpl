{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 30,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,
  "modules-left": [
    "hyprland/workspaces",
    "group/notifications",
    "tray"
  ],
  "modules-center": [
    "custom/weather",
    "clock",
    "custom/gcal",
    "custom/media#feishin",
    "custom/media#tidal",
    "custom/media#browser"
  ],
  "modules-right": [
    "custom/update",
    "group/connectivity",
    "group/audio",
    "group/system",
    "group/power",
    "custom/screenrecording-indicator"
  ],
  "group/notifications": {
    "orientation": "horizontal",
    "modules": [
      "custom/ai",
      "custom/notifications"
    ]
  },
  "group/audio": {
    "orientation": "horizontal",
    "modules": [
      "pulseaudio",
      "custom/voxtype"
    ]
  },
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "bluetooth",
      "network"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "memory"
    ]
  },
  "hyprland/workspaces": {
    "on-click": "activate",
    "tooltip": false,
    "format": "{icon}",
    "all-outputs": false,
    "format-icons": {
      "default": "",
      "1": "󰖟",
      "2": "",
      "3": "",
      "4": "󰖣",
      "5": "󰹜",
      "6": "",
      "8": "󰓓",
      "9": "",
      "10": "󰟵",
    },
    "persistent-workspaces": {
      // "1": [],
      // "2": [],
      // "3": [],
      // "8": [],
      // "9": [],
      // "10": [],
    }
  },
  "custom/update": {
    "format": "{text}",
    "exec": "sys-update-available",
    "on-click": "sys-launch float sys-update",
    "tooltip-format": "Package updates available — click to update",
    "interval": 21600
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": [
      "custom/watts",
      "battery"
    ]
  },
  "custom/watts": {
    "exec": "$HOME/.config/waybar/system-watts.sh",
    "return-type": "json",
    "interval": 6,
    "format": "{text}",
    "tooltip": true,
    "on-click": "sys-menu system"
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% 󰍛",
    "on-click": "sys-launch focus btop sys-launch tui btop"
  },
"memory": {
    "interval": 5,
    "format": "{avail:0.1f}GB ",
    "tooltip-format": "{used:0.1f}GB used ({percentage}%)\n{avail:0.1f}GB free of {total:0.1f}GB total",
    "states": {
      "warning": 75,
      "critical": 90
    },
    "on-click": "sys-launch focus btop sys-launch tui btop"
  },
  "clock": {
    "format": "{:L%d.%m %a %H:%M}",
    "tooltip": false,
    "on-click-right": "sys-tz-select"
  },
  "custom/gcal": {
    "exec": "$HOME/.config/waybar/gcal-next-meeting.sh",
    "return-type": "json",
    "interval": 600,
    "tooltip": true
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 3600,
    "exec": "wttrbar --nerd --location Swarzedz --lang pl --hide-conditions",
    "return-type": "json"
  },
  "custom/media#feishin": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
      "Feishin": "",
      "default": ""
    },
    "escape": true,
    "tooltip": true,
    "on-click": "playerctl --player Feishin play-pause",
    "on-click-right": "playerctl --player Feishin next",
    "on-click-middle": "playerctl --player Feishin previous",
    "exec": "$HOME/.config/waybar/mediaplayer.py --player Feishin 2> /dev/null"
  },
  "custom/media#tidal": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
      "typhoon": "",
      "default": ""
    },
    "escape": true,
    "tooltip": true,
    "on-click": "playerctl --player typhoon play-pause",
    "on-click-right": "playerctl --player typhoon next",
    "on-click-middle": "playerctl --player typhoon previous",
    "exec": "$HOME/.config/waybar/mediaplayer.py --player typhoon 2> /dev/null"
  },
  "custom/media#browser": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
      "firefox": "󰖟",
      "zen": "",
      "zen-browser": "",
      "chromium": "",
      "default": "󰖟"
    },
    "escape": true,
    "tooltip": true,
    "on-click": "playerctl --ignore-player Feishin,typhoon play-pause",
    "on-click-right": "playerctl --ignore-player Feishin,typhoon next",
    "on-click-middle": "playerctl --ignore-player Feishin,typhoon previous",
    "exec": "$HOME/.config/waybar/mediaplayer.py --exclude Feishin,typhoon 2> /dev/null"
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "sys-launch wifi"
  },
  "battery": {
{{- if eq .chezmoi.osRelease.id "archarm" }}
    "bat": "macsmc-battery",
    "format": "{capacity}% {icon}",
{{- else }}
    "format": "{power:>1.0f}W {capacity}% {icon}",
{{- end }}
    "format-plugged": "",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "󰂅",
    "tooltip-format-discharging": "{time} until empty · {power:.0f}W draw",
    "tooltip-format-charging": "{time} until full · {power:.0f}W charging",
    "tooltip-format-plugged": "Plugged in · not charging",
    "interval": 5,
    "on-click": "sys-menu system",
    "on-click-right": "notify-send -u low \"$(sys-battery-status)\"",
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "sys-launch bluetooth"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "on-click": "sys-launch audio",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "custom/notifications": {
    "exec": "$HOME/.config/waybar/notifications.sh",
    "return-type": "json",
    "interval": 30,
    "signal": 12,
    "on-click": "makoctl restore",
    "on-click-middle": "bash -c 'n=$(cat /tmp/mako-last-count 2>/dev/null || echo 1); for i in $(seq 1 $n); do makoctl restore; done; echo 0 > /tmp/mako-unread-count && pkill -SIGRTMIN+12 waybar'",
    "on-click-right": "bash -c 'makoctl dismiss -a; echo 0 > /tmp/mako-unread-count && pkill -SIGRTMIN+12 waybar'"
  },
  "custom/ai": {
    "exec": "$HOME/.config/waybar/ai-indicator.sh",
    "return-type": "json",
    "signal": 11,
    "on-click": "rm -f /tmp/ai-count && pkill -SIGRTMIN+11 waybar",
    "tooltip": true
  },
  "custom/screenrecording-indicator": {
    "on-click": "sys-screenrecord",
    "exec": "$HOME/.config/waybar/screen-recording.sh",
    "signal": 8,
    "return-type": "json"
  },
  "custom/voxtype": {
    "exec": "$HOME/.config/waybar/voxtype-status.sh",
    "interval": 1,
    "return-type": "json",
    "format": "{}",
    "tooltip": true,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-click-right": "sys-launch audio"
  },
  "custom/idle-indicator": {
    "on-click": "sys-toggle-idle",
    "exec": "$HOME/.config/waybar/idle-indicator.sh",
    "signal": 9,
    "return-type": "json"
  },
  "custom/notification-silencing-indicator": {
    "on-click": "sys-toggle-notifications",
    "exec": "$HOME/.config/waybar/notification-silencing.sh",
    "signal": 10,
    "return-type": "json"
  },
  "tray": {
    "icon-size": 12,
    "spacing": 17
  }
}
