# Application bindings
bindd = SUPER, RETURN, Terminal, exec, uwsm-app -- xdg-terminal-exec --dir="$(sys-terminal-cwd)"
bindd = SUPER ALT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir="$(sys-terminal-cwd)" bash -c "tmux attach || tmux new -s Work"
bindd = SUPER SHIFT, RETURN, Browser, exec, sys-launch browser
bindd = SUPER SHIFT, F, File manager, exec, uwsm-app -- nautilus --new-window
bindd = SUPER ALT SHIFT, F, File manager (cwd), exec, uwsm-app -- nautilus --new-window "$(sys-terminal-cwd)"
bindd = SUPER SHIFT, B, Browser, exec, sys-launch browser
bindd = SUPER SHIFT ALT, B, Browser (private), exec, sys-launch browser --private
bindd = SUPER SHIFT, M, Music, exec, sys-launch webapp "https://spotify.com"
bindd = SUPER SHIFT ALT, M, Music TUI, exec, sys-launch focus cliamp sys-launch tui cliamp
bindd = SUPER SHIFT ALT, G, WhatsApp, exec, sys-launch focus WhatsApp sys-launch webapp "https://web.whatsapp.com/"
bindd = SUPER SHIFT, N, Editor, exec, sys-launch editor
bindd = SUPER SHIFT, D, Docker, exec, sys-launch tui lazydocker
bindd = SUPER SHIFT, G, Signal, exec, sys-launch focus '^signal$' uwsm-app -- signal-desktop
bindd = SUPER SHIFT, O, Obsidian, exec, sys-launch focus '^obsidian$' uwsm-app -- obsidian -disable-gpu --enable-wayland-ime
bindd = SUPER SHIFT, W, Typora, exec, uwsm-app -- typora --enable-wayland-ime
bindd = SUPER SHIFT, SLASH, Passwords, exec, uwsm-app -- 1password

# Launcher (fuzzel)
bindd = SUPER, SPACE, Launch apps, exec, sys-launch apps
bindd = SUPER ALT, SPACE, Menu, exec, sys-menu
bindr = SUPER SHIFT, V, exec, sys-launch clipboard

# Add extra bindings
# bind = SUPER SHIFT, R, exec, alacritty -e ssh your-server

# Overwrite existing bindings, like putting Menu on Super + Space
# unbind = SUPER, SPACE
# bindd = SUPER, SPACE, Menu, exec, sys-menu

# Logitech MX Keys
# bind = SUPER SHIFT, S, exec, sys-screenshot      # Print Screen Button
# bind = SUPER, H, exec, voxtype record toggle                 # Dictation Button
# bind = SUPER, PERIOD, exec, sys-launch emoji             # Emoji Button
{{- if eq .chezmoi.osRelease.id "archarm" }}

# Keyboard backlight (Super+F1/F2; native Apple kbd-bright keys removed on this model)
bindle = SUPER, XF86MonBrightnessDown, exec, brightnessctl --device='kbd_backlight' set 10%-
bindle = SUPER, XF86MonBrightnessUp,   exec, brightnessctl --device='kbd_backlight' set +10%
{{- end }}
