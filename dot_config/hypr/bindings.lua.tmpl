-- Application bindings.
-- Migrated from bindings.conf.tmpl

hl.bind("SUPER + RETURN", hl.dsp.exec_cmd('uwsm-app -- xdg-terminal-exec --dir="$(sys-terminal-cwd)"'), { description = "Terminal" })
hl.bind("SUPER + ALT + RETURN", hl.dsp.exec_cmd('uwsm-app -- xdg-terminal-exec --dir="$(sys-terminal-cwd)" bash -c "tmux attach || tmux new -s Work"'), { description = "Tmux" })
hl.bind("SUPER + SHIFT + RETURN", hl.dsp.exec_cmd("sys-launch browser"), { description = "Browser" })
hl.bind("SUPER + SHIFT + F", hl.dsp.exec_cmd("uwsm-app -- nautilus --new-window"), { description = "File manager" })
hl.bind("SUPER + ALT + SHIFT + F", hl.dsp.exec_cmd('uwsm-app -- nautilus --new-window "$(sys-terminal-cwd)"'), { description = "File manager (cwd)" })
hl.bind("SUPER + SHIFT + B", hl.dsp.exec_cmd("sys-launch browser"), { description = "Browser" })
hl.bind("SUPER + SHIFT + ALT + B", hl.dsp.exec_cmd("sys-launch browser --private"), { description = "Browser (private)" })
hl.bind("SUPER + SHIFT + M", hl.dsp.exec_cmd('sys-launch webapp "https://spotify.com"'), { description = "Music" })
hl.bind("SUPER + SHIFT + ALT + G", hl.dsp.exec_cmd('sys-launch focus WhatsApp sys-launch webapp "https://web.whatsapp.com/"'), { description = "WhatsApp" })
hl.bind("SUPER + SHIFT + N", hl.dsp.exec_cmd("sys-launch editor"), { description = "Editor" })
hl.bind("SUPER + SHIFT + D", hl.dsp.exec_cmd("sys-launch tui lazydocker"), { description = "Docker" })
hl.bind("SUPER + SHIFT + G", hl.dsp.exec_cmd("sys-launch focus '^signal$' uwsm-app -- signal-desktop"), { description = "Signal" })
hl.bind("SUPER + SHIFT + O", hl.dsp.exec_cmd("sys-launch focus '^obsidian$' uwsm-app -- obsidian -disable-gpu --enable-wayland-ime"), { description = "Obsidian" })
hl.bind("SUPER + SHIFT + W", hl.dsp.exec_cmd("uwsm-app -- typora --enable-wayland-ime"), { description = "Typora" })
hl.bind("SUPER + SHIFT + SLASH", hl.dsp.exec_cmd("uwsm-app -- bitwarden-desktop"), { description = "Passwords" })
hl.bind("SUPER + SHIFT + A", hl.dsp.exec_cmd("sys-ai"), { description = "AI sessions" })

-- Launcher + menu live in ~/.config/hypr/base/bindings/utilities.lua
hl.bind("SUPER + SHIFT + V", hl.dsp.exec_cmd("sys-launch clipboard"), { release = true, description = "Clipboard manager (release)" })

