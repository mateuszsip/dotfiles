{{- if eq .chezmoi.osRelease.id "archarm" }}

-- Keyboard backlight (Super+F1/F2; native Apple kbd-bright keys removed on this model)
hl.bind("SUPER + XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl --device='kbd_backlight' set 10%-"), { locked = true, repeating = true, description = "Keyboard brightness down" })
hl.bind("SUPER + XF86MonBrightnessUp", hl.dsp.exec_cmd("brightnessctl --device='kbd_backlight' set +10%"), { locked = true, repeating = true, description = "Keyboard brightness up" })
{{- end }}
