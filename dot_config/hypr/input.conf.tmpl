# Control your input devices
# See https://wiki.hypr.land/Configuring/Variables/#input
input {
  # Use the custom plmac layout (Mac ISO + Polish diacritics on Right Option)
{{- if eq .chezmoi.osRelease.id "archarm" }}
  # plmac = custom gb(mac)-based layout with Polish diacritics on AltGr
  # (a=ą c=ć e=ę l=ł n=ń o=ó s=ś x=ź z=ż). Preserves `~ next to Z on Mac ISO.
  # Installed by run_onchange_before-plmac-keyboard.sh.tmpl
  kb_layout = plmac
  # altwin:swap_lalt_lwin (not full swap_alt_win) keeps right Option as AltGr
  # so Polish diacritics on AltGr work; left Alt/Cmd still swap for shortcuts.
  # caps:escape remaps Caps Lock -> Escape (was compose:caps).
  # Polish diacritics still work via AltGr in the plmac layout.
  kb_options = caps:escape,altwin:swap_lalt_lwin
{{- else }}
  kb_layout = pl
  kb_options = caps:escape # ,grp:alts_toggle
{{- end }}

  # Change speed of keyboard repeat
  repeat_rate = 40
  repeat_delay = 600

  # Start with numlock on by default
  numlock_by_default = true

  # Increase sensitivity for mouse/trackpad (default: 0)
  # sensitivity = 0.35

  touchpad {
    # Use natural (inverse) scrolling
    natural_scroll = true

    # Use two-finger clicks for right-click instead of lower-right corner
    # clickfinger_behavior = true

    # Control the speed of your scrolling
    scroll_factor = 0.4

    # Enable the touchpad while typing
    # disable_while_typing = false
    disable_while_typing = true

    # Left-click-and-drag with three fingers
    # drag_3fg = 1
  }
}

# Scroll nicely in the terminal
windowrule = match:class (Alacritty|kitty|foot), scroll_touchpad 1.5
windowrule = match:class com.mitchellh.ghostty, scroll_touchpad 0.2

gesture = 3, horizontal, workspace

# Bosto touchpad (Apple MT2 clone, hid-multitouch driver)
device {
  name = hid-05ac:0265-touchpad
  sensitivity = 0.4        # -1.0 (slow) to 1.0 (fast), 0.0 = default
  accel_profile = adaptive  # adaptive | flat (flat = no acceleration)
  scroll_factor = 0.4
  natural_scroll = true
}
