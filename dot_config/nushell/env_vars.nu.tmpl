$env.PAGER = "bat"

$env.K9S_SKIN = 'solarized-light'

{{- if eq .chezmoi.os "darwin" }}
$env.PATH ++= ['/opt/homebrew/bin']
{{- if .work_machine }}
# mysql 9+ dropped mysql_native_password; the 8.4 client still ships it
$env.PATH = ($env.PATH | prepend '/opt/homebrew/opt/mysql-client@8.4/bin')
{{- end }}
$env.LANG = "en_GB.UTF-8"
{{ if .homebrew_user_appdir -}}
$env.HOMEBREW_CASK_OPTS = "--appdir=~/Applications"
{{- end }}
{{- end }}

{{- if .bitwarden_agent }}
{{- if eq .chezmoi.os "darwin" }}
$env.SSH_AUTH_SOCK = "/Users/sip/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"
{{- else }}
$env.SSH_AUTH_SOCK = "/home/sip/.bitwarden-ssh-agent.sock"
{{- end }}
{{- end }}

if (which npm | is-not-empty) {
    $env.PATH ++= [ $"(npm config --global get prefix)/bin"]
}

$env.PATH ++= ['~/.local/bin']
$env.PATH ++= ['/usr/local/bin']
$env.PATH ++= ['~/.atuin/bin']
$env.PATH ++= ['~/.antigravity/bin']


# GitHub MCP servers (claude-code github plugin, opencode) read this var
if (which gh | is-not-empty) {
    let gh_token = (do -i { gh auth token } | complete)
    if $gh_token.exit_code == 0 and ($gh_token.stdout | str trim | is-not-empty) {
        $env.GITHUB_PERSONAL_ACCESS_TOKEN = ($gh_token.stdout | str trim)
    }
}
